DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/recallindia
FOSCOS_URL=https://foscos.fssai.gov.in/
RECALL_URL=https://foscos.fssai.gov.in/food-recall
SCRAPER_HEADLESS=1
SCRAPER_MAX_PAGES=100

# Review queue: >= AUTO_PUBLISH_SCORE is shown and alerted; REVIEW_MIN_SCORE up to that waits for a reviewer
AUTO_PUBLISH_SCORE=85
REVIEW_MIN_SCORE=65

# Alerts: outbox (writes .eml files to data/outbox), email (SMTP) or console
ALERT_CHANNEL=outbox
ALERT_FROM=alerts@recallindia.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Intake
TESSERACT_CMD=
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json
